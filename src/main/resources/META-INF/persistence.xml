<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="4.0">
    <persistence-unit name="talk">
        <class>com.thorben.janssen.talk.model.ChessTournament</class>
        <class>com.thorben.janssen.talk.model.ChessGame</class>
        <class>com.thorben.janssen.talk.model.ChessPlayer</class>
        <class>com.thorben.janssen.talk.model.ChessMove</class>
        <!-- Example 1 - new in Jakarta Persistence 4 / Hibernate 8: default fetch type of to-one associations
             without a fetch attribute (FetchType.DEFAULT) -->
        <!-- <default-to-one-fetch-type>LAZY</default-to-one-fetch-type> -->
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/talk"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.generate_statistics" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
